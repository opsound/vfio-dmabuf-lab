# Merged on top of linux-x86_64.config for the rc6 and rc6-fix kernels.
# SLUB_RCU_DEBUG delays SLAB_TYPESAFE_BY_RCU frees by a grace period so
# KASAN can report use-after-free on struct file.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
# CONFIG_KASAN_VMALLOC is not set
CONFIG_SLUB_RCU_DEBUG=y
