#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only

set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
action="${1:-all}"

case "${action}" in
all)
	make -C "${root}" -j"${JOBS:-$(nproc)}" all TEST_JOBS="${TEST_JOBS:-1}"
	;;
build)
	make -C "${root}" -j"${JOBS:-$(nproc)}" build
	;;
test)
	shift
	"${root}/scripts/run-tests.sh" "$@"
	;;
*)
	echo "usage: $0 [all|build|test [--jobs N] [--dry-run] [all|<kernel>|<test>|<kernel>:<test>]]" >&2
	exit 2
	;;
esac
