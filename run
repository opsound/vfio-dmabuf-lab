#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only

set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
action="${1:-all}"

case "${action}" in
all)
	"${root}/scripts/build.sh"
	"${root}/scripts/run-tests.sh" all
	;;
build)
	"${root}/scripts/build.sh"
	;;
test)
	"${root}/scripts/run-tests.sh" "${2:-all}"
	;;
*)
	echo "usage: $0 [all|build|test [all|nvgrace-v6|dmabuf|nvgrace-v5]]" >&2
	exit 2
	;;
esac
