#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only

set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
action="${1:-all}"

case "${action}" in
all)
	"${root}/scripts/build.sh"
	"${root}/scripts/run-tests.sh" all
	;;
build)
	"${root}/scripts/build.sh"
	;;
test)
	shift
	"${root}/scripts/run-tests.sh" "$@"
	;;
*)
	echo "usage: $0 [all|build|test [--jobs N] [--dry-run] [all|<kernel>|<test>|<kernel>:<test>]]" >&2
	exit 2
	;;
esac
